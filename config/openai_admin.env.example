# OpenAI Platform usage credentials (keep this file private).
# Create an Admin key with the api.usage.read scope:
# https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=
# Pro subscription API-credit grant (not a local budget). Set this to the
# monthly grant for your Pro tier; the tool shows an estimated remaining value.
OPENAI_PRO_CREDIT=100
# Expected monthly credit refresh day (billing-cycle anniversary). The exact
# time is controlled by OpenAI; the tool labels the remaining value "estimated".
OPENAI_CREDIT_REFRESH_DAY=14
# Optional: browser session key for the legacy prepaid-credit endpoint.
# This expires and is sensitive; leave empty unless you really need it.
OPENAI_SESSION_KEY=