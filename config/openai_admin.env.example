# OpenAI Platform usage credentials (keep this file private).
# Create an Admin key with the api.usage.read scope:
# https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=
# Local reference allowance. This setting does not verify a grant, billing
# cycle or balance. The tool subtracts returned UTC-calendar-month costs only
# to show a reference difference, excluding costs not yet returned by the API.
OPENAI_PRO_CREDIT=100
# Optional local notes, not evidence that a grant refreshed on this date.
OPENAI_CREDIT_REFRESH_DAY=14
OPENAI_CREDIT_REFRESH_NOTE=预计每月14日，具体以 Platform 为准
# Optional: browser session key for the legacy prepaid-credit endpoint.
# This expires and is sensitive; leave empty unless you really need it.
OPENAI_SESSION_KEY=
