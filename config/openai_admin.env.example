# OpenAI Platform usage credentials (keep this file private).
# Create an Admin key with the api.usage.read scope:
# https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=
# Monthly API budget used to calculate "remaining budget" (not a live credit balance).
OPENAI_MONTHLY_BUDGET=100
# Optional: browser session key for the legacy prepaid-credit endpoint.
# This expires and is sensitive; leave empty unless you really need it.
OPENAI_SESSION_KEY=