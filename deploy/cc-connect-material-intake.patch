+func TestBusyMaterialBatchSurvivesFullQueueAndKeepsIdentity(t *testing.T) {
+	p := &stubPlatformEngine{n: "test"}
+	e := newTestEngine()
+	e.baseWorkDir = t.TempDir()
+	e.maxQueuedMessages = 1
+	key := "test:material"
+	state := &interactiveState{platform: p, pendingMessages: []queuedMessage{{content: "ordinary existing chat"}}}
+	e.interactiveStates[key] = state
+	for i, content := range []string{"先发通知，材料还没齐", "这是成绩表", "发完了，先填"} {
+		msg := &Message{SessionKey: key, Platform: "test", UserID: "student", MessageID: []string{"notice", "sheet", "done"}[i], Content: content, SourceUserContent: content}
+		if i == 1 {
+			msg.Files = []FileAttachment{{FileName: "original.xlsx", Data: []byte("original-spreadsheet")}}
+		}
+		accepted := false
+		msg.OnAccepted = func() { accepted = true }
+		if !e.queueMessageForBusySession(p, msg, key) || !accepted {
+			t.Fatalf("material %d rejected at full queue", i)
+		}
+	}
+	if len(state.pendingMessages) != 2 {
+		t.Fatalf("expected one chat and one material batch, got %d", len(state.pendingMessages))
+	}
+	combined := state.pendingMessages[1].content
+	for _, want := range []string{"先发通知", "这是成绩表", "发完了"} {
+		if !strings.Contains(combined, want) {
+			t.Fatalf("batch missing %q: %s", want, combined)
+		}
+	}
+	other := &Message{SessionKey: key, Platform: "test", UserID: "other-student", MessageID: "other", Content: "我的成绩表", SourceUserContent: "我的成绩表"}
+	e.queueMessageForBusySession(p, other, key)
+	if len(state.pendingMessages) != 3 {
+		t.Fatal("different senders were merged")
+	}
+	if strings.Contains(state.pendingMessages[1].content, "我的成绩表") {
+		t.Fatal("another sender entered the batch")
+	}
