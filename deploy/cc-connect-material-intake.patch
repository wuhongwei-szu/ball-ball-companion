+package core
+
+// Material intake uses the existing busy-session queue and attachment store.
+// It never waits before an idle chat turn or forwards input to a running agent.
+import (
+	"encoding/json"
+	"log/slog"
+	"strings"
+)
+
+func materialIdentity(p Platform, sessionKey, userID string) string {
+	if p == nil || sessionKey == "" || userID == "" {
+		return ""
+	}
+	return strings.Join([]string{p.Name(), PlatformAccountID(p), sessionKey, userID}, "\x00")
+}
+
+func isMaterialInput(msg *Message) bool {
+	if len(msg.Images) > 0 {
+		return true
+	}
+	for _, file := range msg.Files {
+		if !strings.HasPrefix(strings.ToLower(file.MimeType), "audio/") {
+			return true
+		}
+	}
+	text := strings.ToLower(msg.Content)
+	for _, word := range []string{"材料", "通知", "表格", "压缩包", "成绩", "绩点", "填表", "申请表", "发完了", "先填", "可以填", "收齐了", ".doc", ".xls", ".zip"} {
+		if strings.Contains(text, word) {
+			return true
+		}
+	}
+	return false
+}
+
+// Caller holds state.mu. Context extends only the current/queued material turn
+// for the exact configured account, conversation and authenticated sender.
+func materialInputLocked(state *interactiveState, p Platform, msg *Message) bool {
+	if isMaterialInput(msg) {
+		return true
+	}
+	identity := materialIdentity(p, msg.SessionKey, msg.UserID)
+	if identity == "" {
+		return false
+	}
+	if state.currentMaterialIdentity == identity {
+		return true
+	}
+	for _, queued := range state.pendingMessages {
+		if queued.material && materialIdentity(queued.platform, queued.msgSessionKey, queued.userID) == identity {
+			return true
+		}
+	}
+	return false
+}
+
+func (e *Engine) classifyMaterialInput(key string, p Platform, msg *Message) {
+	msg.materialInput = isMaterialInput(msg)
+	e.interactiveMu.Lock()
+	state := e.interactiveStates[key]
+	e.interactiveMu.Unlock()
+	if state != nil {
+		state.mu.Lock()
+		msg.materialInput = materialInputLocked(state, p, msg)
+		state.mu.Unlock()
+	}
+}
+
+func (e *Engine) noteMaterialTurn(key string, p Platform, msg *Message) {
+	e.interactiveMu.Lock()
+	state := e.interactiveStates[key]
+	e.interactiveMu.Unlock()
+	if state == nil {
+		return
+	}
+	state.mu.Lock()
+	state.currentMaterialIdentity = ""
+	if msg.materialInput {
+		state.currentMaterialIdentity = materialIdentity(p, msg.SessionKey, msg.UserID)
+	}
+	state.mu.Unlock()
+}
+
+func (e *Engine) queuedMaterial(p Platform, msg *Message, state *interactiveState, material bool) queuedMessage {
+	queued := queuedMessage{
+		messageID: msg.MessageID, platform: p, replyCtx: msg.ReplyCtx,
+		content: msg.Content, sourceUserContent: msg.SourceUserContent,
+		images: msg.Images, files: msg.Files, fromVoice: msg.FromVoice,
+		userID: msg.UserID, userName: msg.UserName, msgPlatform: msg.Platform,
+		msgSessionKey: msg.SessionKey, channelKey: msg.ChannelKey,
+		userMessageTimeMs: msg.UserMessageTimeMs, material: material,
+	}
+	if !material {
+		return queued
+	}
+	workDir := state.workspaceDir
+	if workDir == "" {
+		workDir = e.currentSendWorkDir()
+	}
+	// Keep image inputs for native vision, but also retain their original bytes.
+	attachments := append([]FileAttachment(nil), msg.Files...)
+	for _, image := range msg.Images {
+		attachments = append(attachments, FileAttachment{MimeType: image.MimeType, FileName: image.FileName, Data: image.Data})
+	}
+	paths := SaveFilesToDisk(workDir, msg.MessageID, attachments)
+	if len(paths) == len(attachments) {
+		queued.content = AppendFileRefs(queued.content, paths)
+		// Keep FileAttachment inputs too: remote/native backends may require
+		// the original bytes rather than access to this process's local paths.
+	} else {
+		// Failed storage must neither acknowledge a durable receipt nor lose bytes.
+		// Retain all original inputs for the normal agent save path to retry.
+		e.reply(p, msg.ReplyCtx, e.i18n.T(MsgMaterialStorageIncomplete))
+		slog.Warn("material receipt incomplete", "saved_count", len(paths), "attachment_count", len(attachments))
+	}
+	// A local receipt preserves separate authenticated sources even though the
+	// model receives one batch. Never put the synthetic batch into user memory.
+	receipt, _ := json.Marshal(struct {
+		Account string   `json:"account"`
+		Session string   `json:"session_key"`
+		User    string   `json:"user_id"`
+		Message string   `json:"message_id"`
+		Text    string   `json:"text"`
+		Files   []string `json:"files"`
+	}{PlatformAccountID(p), msg.SessionKey, msg.UserID, msg.MessageID, msg.SourceUserContent, paths})
+	if len(SaveFilesToDisk(workDir, msg.MessageID, []FileAttachment{{FileName: "material-receipt.json", Data: receipt}})) != 1 {
+		slog.Warn("material source receipt unavailable")
+	}
+	return queued
+}
+
+func materialParts(queued queuedMessage) []queuedMessage {
+	if len(queued.materialParts) > 0 {
+		return queued.materialParts
+	}
+	return []queuedMessage{queued}
+}
+
+func mergeMaterialMessages(first, next queuedMessage) queuedMessage {
+	parts := append(append([]queuedMessage(nil), materialParts(first)...), materialParts(next)...)
+	combined := next
+	combined.material = true
+	combined.materialParts = parts
+	combined.images, combined.files = nil, nil
+	var body strings.Builder
+	body.WriteString("【系统材料批次：以下是同一账号、会话、发件人连续发送的独立消息，请合并核对全部文字与原附件。消息按到达顺序列出，时间先后不代表材料有效性；已有材料不要重复索要。】")
+	for _, part := range parts {
+		body.WriteString("\n\n【独立消息】\n")
+		body.WriteString(part.content)
+		combined.images = append(combined.images, part.images...)
+		combined.files = append(combined.files, part.files...)
+		if part.userMessageTimeMs > combined.userMessageTimeMs {
+			combined.userMessageTimeMs = part.userMessageTimeMs
+		}
+	}
+	combined.content = body.String()
+	return combined
+}
+
+func (e *Engine) appendQueuedCompanionMemory(prompt string, queued queuedMessage) string {
+	withMemory := prompt
+	for _, part := range materialParts(queued) {
+		// Record each source once, but keep only the newest retrieval packet.
+		// Nesting packets would repeat the same memory for every attachment.
+		withMemory = e.appendCompanionMemory(prompt, part.platform, part.msgSessionKey, part.userID, part.messageID, part.sourceUserContent)
+	}
+	return withMemory
+}
+
+func removeMaterialPart(queued queuedMessage, messageID string) (queuedMessage, bool, bool) {
+	if len(queued.materialParts) == 0 {
+		return queued, queued.messageID == messageID, queued.messageID == messageID
+	}
+	var retained []queuedMessage
+	removed := false
+	for _, part := range queued.materialParts {
+		if part.messageID == messageID {
+			removed = true
+		} else {
+			retained = append(retained, part)
+		}
+	}
+	if !removed {
+		return queued, false, false
+	}
+	if len(retained) == 0 {
+		return queued, true, true
+	}
+	rebuilt := retained[0]
+	for _, part := range retained[1:] {
+		rebuilt = mergeMaterialMessages(rebuilt, part)
+	}
+	return rebuilt, true, false
+}
