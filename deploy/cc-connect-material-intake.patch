+func TestCompletedTurnDrainsOlderMaterialBatch(t *testing.T) {
+	p := &stubPlatformEngine{n: "test"}
+	sess := newQueuingSession("material-event-drain")
+	e := NewEngine("test", &controllableAgent{nextSession: sess}, []Platform{p}, "", LangEnglish)
+	e.baseWorkDir = t.TempDir()
+	key := "test:events"
+	session := e.sessions.GetOrCreateActive(key)
+	state := &interactiveState{agentSession: sess, platform: p, currentTurnUserMessageTimeMs: 900}
+	e.interactiveStates[key] = state
+	e.queueMessageForBusySession(p, &Message{SessionKey: key, UserID: "student", MessageID: "old-material", Content: "旧时间戳的完整材料，先填", UserMessageTimeMs: 100}, key)
+	sendDone := make(chan error, 1)
+	sendDone <- nil
+	done := make(chan struct{})
+	go func() {
+		e.processInteractiveEvents(state, session, e.sessions, key, "first", time.Now(), nil, sendDone, nil)
+		close(done)
+	}()
+	sess.events <- Event{Type: EventResult, Content: "previous done", Done: true}
+	deadline := time.After(5 * time.Second)
+	for {
+		sess.sendMu.Lock()
+		n := len(sess.sendCalls)
+		sess.sendMu.Unlock()
+		if n > 0 {
+			sess.events <- Event{Type: EventResult, Content: "material done", Done: true}
+			break
+		}
+		select {
+		case <-deadline:
+			t.Fatal("completed-turn drain dropped older material")
+		case <-time.After(5 * time.Millisecond):
+		}
+	}
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("event loop did not finish")
+	}
+}
