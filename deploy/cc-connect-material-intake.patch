+func TestMaterialSaveFailureRetainsRawBytes(t *testing.T) {
+	e := newTestEngine()
+	e.i18n = NewI18n(LangChinese)
+	e.baseWorkDir = t.TempDir()
+	if err := os.WriteFile(filepath.Join(e.baseWorkDir, ".cc-connect"), []byte("blocks directory"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	p := &stubPlatformEngine{n: "test"}
+	state := &interactiveState{}
+	e.interactiveStates["test:failure"] = state
+	e.queueMessageForBusySession(p, &Message{SessionKey: "test:failure", UserID: "student", MessageID: "file", Files: []FileAttachment{{FileName: "form.xlsx", Data: []byte("do-not-drop")}}}, "test:failure")
+	if len(state.pendingMessages) != 1 || len(state.pendingMessages[0].files) != 1 || string(state.pendingMessages[0].files[0].Data) != "do-not-drop" {
+		t.Fatal("disk failure dropped the only copy")
+	}
+	if !strings.Contains(strings.Join(p.getSent(), "\n"), "暂存未全部成功") {
+		t.Fatal("storage failure was silent")
+	}
+}
