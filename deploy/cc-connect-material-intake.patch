+		if err == nil && !d.IsDir() {
+			b, _ := os.ReadFile(path)
+			if string(b) == "complete-original" {
+				found = true
+			}
+		}
+		return nil
+	})
+	if !found {
+		t.Fatal("queued material was not saved before agent.Send")
+	}
+}
