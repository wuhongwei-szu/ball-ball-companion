+func TestMaterialBatchDrainDeliversAllOriginalsAndSources(t *testing.T) {
+	p := &stubPlatformEngine{n: "test"}
+	sess := newQueuingSession("material-drain")
+	e := NewEngine("test", &controllableAgent{nextSession: sess}, []Platform{p}, "", LangEnglish)
+	e.baseWorkDir = t.TempDir()
+	key := "test:material"
+	session := e.sessions.GetOrCreateActive(key)
+	state := &interactiveState{agentSession: sess, platform: p, currentTurnUserMessageTimeMs: 900, lastCompletedUserMessageTimeMs: 800}
+	e.interactiveStates[key] = state
+	texts := []string{"学校通知：这是申请条件", "压缩包附件", "原Word与Excel表格", "最终成绩：90；发完了，先填"}
+	for i, text := range texts {
+		msg := &Message{SessionKey: key, Platform: "test", UserID: "student", MessageID: []string{"notice", "archive", "forms", "scores"}[i], Content: text, SourceUserContent: text, UserMessageTimeMs: int64(100 - i)}
+		switch i {
+		case 1:
+			msg.Files = []FileAttachment{{FileName: "materials.zip", Data: []byte("all-archive-bytes")}}
+		case 2:
+			msg.Files = []FileAttachment{{FileName: "form.docx", Data: []byte("all-word-bytes")}, {FileName: "form.xlsx", Data: []byte("all-excel-bytes")}}
+		}
+		e.queueMessageForBusySession(p, msg, key)
+	}
+	if len(state.pendingMessages) != 1 {
+		t.Fatalf("batch depth=%d", len(state.pendingMessages))
+	}
+	batch := state.pendingMessages[0]
+	if len(batch.files) != 3 {
+		t.Fatalf("native file inputs dropped: got %d, want 3", len(batch.files))
+	}
+	if len(batch.materialParts) != 4 {
+		t.Fatalf("source count=%d", len(batch.materialParts))
+	}
+	for i, part := range batch.materialParts {
+		if part.sourceUserContent != texts[i] {
+			t.Fatal("source text rewritten")
+		}
+	}
+	seen := map[string]bool{}
+	receipts := 0
+	_ = filepath.WalkDir(filepath.Join(e.baseWorkDir, ".cc-connect", "attachments"), func(path string, d os.DirEntry, err error) error {
+		if err != nil || d.IsDir() {
+			return nil
+		}
+		b, _ := os.ReadFile(path)
+		if strings.Contains(d.Name(), "material-receipt") {
+			var receipt struct {
+				Text string `json:"text"`
+			}
+			if json.Unmarshal(b, &receipt) != nil {
+				t.Fatal("receipt json")
+			}
+			for _, text := range texts {
+				if receipt.Text == text {
+					receipts++
+				}
+			}
+		} else {
+			seen[string(b)] = true
+		}
+		return nil
+	})
+	for _, raw := range []string{"all-archive-bytes", "all-word-bytes", "all-excel-bytes"} {
+		if !seen[raw] {
+			t.Fatalf("missing complete original %s", raw)
+		}
+	}
+	if receipts != 4 {
+		t.Fatalf("raw source receipts=%d", receipts)
+	}
+	done := make(chan struct{})
+	go func() { e.drainPendingMessages(state, session, e.sessions, key); close(done) }()
+	deadline := time.After(5 * time.Second)
+	for {
+		sess.sendMu.Lock()
+		n := len(sess.sendCalls)
+		var prompt string
+		if n > 0 {
+			prompt = sess.sendCalls[0]
+		}
+		sess.sendMu.Unlock()
+		if n > 0 {
+			for _, want := range append(texts, "materials.zip", "form.docx", "form.xlsx") {
+				if !strings.Contains(prompt, want) {
+					t.Fatalf("agent missing %q", want)
+				}
+			}
+			sess.events <- Event{Type: EventResult, Content: "done", Done: true}
+			break
+		}
+		select {
+		case <-deadline:
+			t.Fatal("material did not automatically drain")
+		case <-time.After(5 * time.Millisecond):
+		}
+	}
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("drain did not finish")
+	}
+}
