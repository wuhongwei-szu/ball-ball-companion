+func readPlatformUsage() *core.PlatformUsage {
+	path := strings.TrimSpace(os.Getenv("OPENAI_USAGE_CACHE"))
+	if path == "" {
+		return nil
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return &core.PlatformUsage{Error: "缓存未更新"}
+	}
+	var payload struct {
+		Cost             float64 `json:"cost"`
+		Credit           float64 `json:"credit"`
+		Budget           float64 `json:"budget"`
+		Remaining        float64 `json:"remaining"`
+		Currency         string  `json:"currency"`
+		CreditsAvailable string  `json:"credits_available"`
+		RefreshDay       string  `json:"refresh_day"`
+		RefreshNote      string  `json:"refresh_note"`
+		UpdatedAt        string  `json:"updated_at"`
+		Error            string  `json:"error"`
+	}
+	if err := json.Unmarshal(data, &payload); err != nil {
+		return &core.PlatformUsage{Error: "缓存格式错误"}
+	}
+	return &core.PlatformUsage{
+		Cost:             payload.Cost,
+		Credit:           payload.Credit,
+		Budget:           payload.Budget,
+		Remaining:        payload.Remaining,
+		Currency:         payload.Currency,
+		CreditsAvailable: payload.CreditsAvailable,
+		RefreshDay:       payload.RefreshDay,
+		RefreshNote:      payload.RefreshNote,
+		UpdatedAt:        payload.UpdatedAt,
+		Error:            payload.Error,
+	}
 }
 
