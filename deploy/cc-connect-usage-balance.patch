+func formatPlatformUsage(platform *PlatformUsage, lang Language) string {
+	if platform == nil {
+		return ""
+	}
+	if platform.Error != "" {
+		switch lang {
+		case LangChinese, LangTraditionalChinese:
+			return "Platform 余额：" + platform.Error
+		default:
+			return "Platform balance: " + platform.Error
+		}
+	}
+	currency := platform.Currency
+	if currency == "" {
+		currency = "usd"
+	}
+	updated := platform.UpdatedAt
+	if updated == "" {
+		updated = "-"
+	}
+	credit := platform.Credit
+	if credit == 0 {
+		credit = platform.Budget
+	}
+	refresh := ""
+	if platform.RefreshDay != "" {
+		refresh = "额度刷新：每月" + platform.RefreshDay + "日"
+	} else if platform.RefreshNote != "" {
+		refresh = "额度刷新：" + platform.RefreshNote
+	}
+	var line string
+	switch lang {
+	case LangChinese, LangTraditionalChinese:
+		detail := "数据更新 " + updated
+		if refresh != "" {
+			detail = refresh + "；" + detail
+		}
+		line = fmt.Sprintf("Platform 本月：%s %.2f / Pro 额度 %.2f，预计剩余 %.2f（%s）",
+			currency, platform.Cost, credit, platform.Remaining, detail)
+	default:
+		detail := "data updated " + updated
+		if platform.RefreshDay != "" {
+			detail = "credit refresh: day " + platform.RefreshDay + "; " + detail
+		} else if platform.RefreshNote != "" {
+			detail = "credit refresh: " + platform.RefreshNote + "; " + detail
+		}
+		line = fmt.Sprintf("Platform this month: %s %.2f / Pro credit %.2f, estimated remaining %.2f (%s)",
+			currency, platform.Cost, credit, platform.Remaining, detail)
+	}
+	if platform.CreditsAvailable != "" {
+		switch lang {
+		case LangChinese, LangTraditionalChinese:
+			line += "，credit 余额 " + platform.CreditsAvailable
+		default:
+			line += ", credit balance " + platform.CreditsAvailable
+		}
+	}
+	return line
+}
