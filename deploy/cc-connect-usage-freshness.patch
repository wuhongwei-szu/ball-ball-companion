+package core
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestPlatformUsageShowsUTCMonetaryResultDateAndReferenceOnly(t *testing.T) {
+	difference := 75.0
+	value := &PlatformUsage{Version: 2, Cost: 25, Credit: 100,
+		ReferenceDifference: &difference, HasCostResults: true,
+		PeriodTimezone: "UTC", QueryStart: "2026-11-01T00:00:00Z",
+		QueryEnd: "2026-11-13T16:30:00Z", LastCostDate: "2026-11-12",
+		LastBucketDate: "2026-11-13", FetchedAt: "2026-11-13T16:30:00Z"}
+	for _, lang := range []Language{LangChinese, LangEnglish, LangTraditionalChinese, LangJapanese, LangSpanish} {
+		text := formatPlatformUsage(value, lang)
+		for _, want := range []string{"UTC", "2026-11-12", "2026-11-13", "75.00"} {
+			if !strings.Contains(text, want) {
+				t.Errorf("missing %q in %q", want, text)
+			}
+		}
+		if strings.Contains(text, "预计剩余") || strings.Contains(text, "estimated remaining") {
+			t.Errorf("unverified grant balance claimed: %q", text)
+		}
+	}
+}
+
+func TestPlatformUsageTranslationsCoverEverySupportedLanguage(t *testing.T) {
+	for _, key := range []MsgKey{MsgPlatformCostsError, MsgPlatformCostsRefresh,
+		MsgPlatformCostsEmpty, MsgPlatformCostsSnapshot, MsgPlatformCostsReference, MsgPlatformCostsCreditsValue} {
+		for _, lang := range []Language{LangEnglish, LangChinese, LangTraditionalChinese, LangJapanese, LangSpanish} {
+			if messages[key][lang] == "" {
+				t.Errorf("missing translation %s/%s", key, lang)
+			}
+		}
+	}
+}
+
+func TestPlatformUsageEmptyBucketsAreNotDisplayedAsZeroSpend(t *testing.T) {
+	text := formatPlatformUsage(&PlatformUsage{Version: 2, PeriodTimezone: "UTC",
+		QueryStart: "2026-11-01T00:00:00Z", QueryEnd: "2026-11-13T00:00:00Z",
+		LastBucketDate: "2026-11-12"}, LangChinese)
+	if !strings.Contains(text, "不能确认零花费") || strings.Contains(text, "usd 0.00") {
+		t.Fatalf("empty bucket treated as a zero cost result: %q", text)
+	}
+}
+
+func TestPlatformUsageLegacyCacheNeedsRefresh(t *testing.T) {
+	text := formatPlatformUsage(&PlatformUsage{Cost: 14.59, Remaining: 85.41}, LangChinese)
+	if !strings.Contains(text, "缓存需刷新") || strings.Contains(text, "85.41") {
+		t.Fatalf("legacy cache still claims a balance: %q", text)
+	}
+}
