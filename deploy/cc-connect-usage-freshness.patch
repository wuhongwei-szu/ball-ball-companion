+package codex
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func platformUsageFixture() map[string]any {
+	return map[string]any{"version": 2, "cost": 25.0, "credit": 100.0,
+		"reference_difference": 75.0, "currency": "usd", "has_cost_results": true,
+		"period_timezone": "UTC", "query_start": "2026-11-01T00:00:00Z",
+		"query_end": "2026-11-13T16:30:00Z", "last_cost_date": "2026-11-12",
+		"last_bucket_date": "2026-11-13", "fetched_at": "2026-11-13T16:30:00Z"}
+}
+
+func TestReadPlatformUsagePreservesActualMonetaryResultDate(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "usage.json")
+	t.Setenv("OPENAI_USAGE_CACHE", path)
+	data, _ := json.Marshal(platformUsageFixture())
+	if err := os.WriteFile(path, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	value := readPlatformUsage()
+	if value == nil || value.Error != "" || value.LastCostDate != "2026-11-12" ||
+		value.LastBucketDate != "2026-11-13" || value.ReferenceDifference == nil ||
+		*value.ReferenceDifference != 75 {
+		t.Fatalf("invalid cache result: %#v", value)
+	}
+}
+
+func TestReadPlatformUsageRejectsLegacyOrContradictoryMetadata(t *testing.T) {
+	for _, name := range []string{"legacy", "timezone", "offset", "missing_cost", "missing_date", "later_cost", "balance", "bad_end"} {
+		t.Run(name, func(t *testing.T) {
+			data := platformUsageFixture()
+			switch name {
+			case "legacy":
+				delete(data, "version")
+			case "timezone":
+				data["period_timezone"] = "local"
+			case "offset":
+				data["query_end"] = "2026-11-13T16:30:00+08:00"
+			case "missing_cost":
+				delete(data, "cost")
+			case "missing_date":
+				delete(data, "last_cost_date")
+			case "later_cost":
+				data["last_cost_date"] = "2026-11-14"
+			case "balance":
+				data["reference_difference"] = 99
+			case "bad_end":
+				data["query_end"] = "2026-10-31T00:00:00Z"
+			}
+			path := filepath.Join(t.TempDir(), "usage.json")
+			t.Setenv("OPENAI_USAGE_CACHE", path)
+			payload, _ := json.Marshal(data)
+			if err := os.WriteFile(path, payload, 0600); err != nil {
+				t.Fatal(err)
+			}
+			if value := readPlatformUsage(); value == nil || value.Error == "" {
+				t.Fatalf("invalid metadata accepted: %#v", value)
+			}
+		})
+	}
+}
+
+func TestReadPlatformUsagePreservesErrorWithoutFabricatingMoney(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "usage.json")
+	t.Setenv("OPENAI_USAGE_CACHE", path)
+	if err := os.WriteFile(path, []byte(`{"error":"Platform costs HTTP 403"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if value := readPlatformUsage(); value == nil || value.Error != "Platform costs HTTP 403" {
+		t.Fatalf("error lost: %#v", value)
+	}
+}
