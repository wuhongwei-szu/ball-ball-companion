@@ -0,0 +1,155 @@
+package core
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"strings"
+	"testing"
+)
+
+type queueFailPlatform struct {
+	stubPlatformEngine
+	calls int
+}
+
+func (p *queueFailPlatform) Reply(context.Context, any, string) error {
+	p.calls++
+	return errors.New("synthetic transport failure")
+}
+
+func TestQueueSafetyImageBurst(t *testing.T) {
+	for _, limit := range []int{5, 10} {
+		t.Run(fmt.Sprint(limit), func(t *testing.T) {
+			p := &stubPlatformEngine{n: "test"}
+			e := NewEngine("test", &stubAgent{}, []Platform{p}, "", LangEnglish)
+			if limit == 10 {
+				e.SetMaxQueuedMessages(10)
+			}
+			key := "synthetic-session"
+			state := &interactiveState{}
+			e.interactiveStates[key] = state
+			accepted := 0
+			for i := 0; i < limit+1; i++ {
+				msg := &Message{Platform: "test", SessionKey: key, MessageID: fmt.Sprint(i), Images: []ImageAttachment{{MimeType: "image/png", Data: []byte{1, 2, 3}}}, OnAccepted: func() { accepted++ }}
+				if !e.queueMessageForBusySession(p, msg, key) {
+					t.Fatal("not handled")
+				}
+			}
+			if len(state.pendingMessages) != limit || accepted != limit {
+				t.Fatalf("depth=%d accepted=%d", len(state.pendingMessages), accepted)
+			}
+			for i, q := range state.pendingMessages {
+				if q.messageID != fmt.Sprint(i) || q.content != "" || len(q.images) != 1 {
+					t.Fatalf("FIFO/image mismatch at %d", i)
+				}
+			}
+			if limit == 10 && state.pendingMessages[5].messageID != "5" {
+				t.Fatal("sixth image missing")
+			}
+		})
+	}
+}
+
+func TestQueueSafetyRejectedNotification(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		t.Run(fmt.Sprint(failed), func(t *testing.T) {
+			var logs bytes.Buffer
+			old := slog.Default()
+			slog.SetDefault(slog.New(slog.NewJSONHandler(&logs, nil)))
+			defer slog.SetDefault(old)
+			base := &stubPlatformEngine{n: "test"}
+			bad := &queueFailPlatform{stubPlatformEngine: stubPlatformEngine{n: "test"}}
+			var p Platform = base
+			if failed {
+				p = bad
+			}
+			e := NewEngine("test", &stubAgent{}, []Platform{p}, "", LangEnglish)
+			e.SetMaxQueuedMessages(1)
+			key := "synthetic-private-session"
+			state := &interactiveState{}
+			e.interactiveStates[key] = state
+			first := &Message{Platform: "test", SessionKey: key, MessageID: "synthetic-private-first"}
+			if !e.queueMessageForBusySession(p, first, key) {
+				t.Fatal("first not handled")
+			}
+			accepted := false
+			msg := &Message{Platform: "test", SessionKey: key, MessageID: "synthetic-private-overflow", Content: "synthetic-private-content", Images: []ImageAttachment{{Data: []byte{7}}}, OnAccepted: func() { accepted = true }}
+			before := bad.calls
+			if !e.queueMessageForBusySession(p, msg, key) || accepted || len(state.pendingMessages) != 1 {
+				t.Fatal("rejection changed queue/acceptance")
+			}
+			text := logs.String()
+			for _, want := range []string{"message queued for busy session", queueMessageRef(first), "message rejected: queue full", queueMessageRef(msg), "queue rejection notification result"} {
+				if !strings.Contains(text, want) {
+					t.Fatalf("missing %q", want)
+				}
+			}
+			status := "platform_accepted"
+			if failed {
+				status = "failed"
+				if bad.calls-before != 1 {
+					t.Fatal("unexpected retry")
+				}
+			}
+			if !strings.Contains(text, `"status":"`+status+`"`) {
+				t.Fatal("wrong notification status")
+			}
+			for _, secret := range []string{msg.MessageID, first.MessageID, msg.Content} {
+				if strings.Contains(text, secret) {
+					t.Fatal("raw private data in admission logs")
+				}
+			}
+		})
+	}
+}
+
+func TestQueueSafetyMessageRef(t *testing.T) {
+	a := &Message{Platform: "test", SessionKey: "s", MessageID: "1"}
+	b := *a
+	if queueMessageRef(a) != queueMessageRef(&b) || len(queueMessageRef(a)) != 32 {
+		t.Fatal("unstable reference")
+	}
+	b.SessionKey = "other"
+	if queueMessageRef(a) == queueMessageRef(&b) {
+		t.Fatal("session not scoped")
+	}
+	b.MessageID = ""
+	if queueMessageRef(&b) != "unavailable" {
+		t.Fatal("missing ID must be explicit")
+	}
+}
+
+func TestQueueSafetyReceivedCorrelation(t *testing.T) {
+	var logs bytes.Buffer
+	old := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&logs, nil)))
+	defer slog.SetDefault(old)
+	p := &stubPlatformEngine{n: "test"}
+	e := NewEngine("test", &stubAgent{}, []Platform{p}, "", LangEnglish)
+	e.SetMaxQueuedMessages(1)
+	key := "synthetic-busy-session"
+	session := e.sessions.GetOrCreateActive(key)
+	if !session.TryLock() {
+		t.Fatal("cannot lock session")
+	}
+	defer session.UnlockWithoutUpdate()
+	for i := 0; i < 2; i++ {
+		msg := &Message{Platform: "test", SessionKey: key, MessageID: fmt.Sprint(i), Images: []ImageAttachment{{MimeType: "image/png", Data: []byte{1}}}}
+		logs.Reset()
+		e.handleMessage(p, msg)
+		text := logs.String()
+		want := 2
+		if i == 1 {
+			want = 3
+		}
+		if strings.Count(text, queueMessageRef(msg)) != want {
+			t.Fatalf("received/admission refs do not correlate: %s", text)
+		}
+		if !strings.Contains(text, "message received") {
+			t.Fatal("missing received")
+		}
+	}
+}
