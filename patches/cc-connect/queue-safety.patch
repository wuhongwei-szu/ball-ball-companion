+// queueMessageRef links admission diagnostics without logging identifiers or content.
+// Missing platform message IDs cannot provide reliable per-message correlation.
+func queueMessageRef(msg *Message) string {
+	if msg.MessageID == "" {
+		return "unavailable"
+	}
+	digest := sha256.Sum256([]byte(msg.Platform + "\x00" + msg.SessionKey + "\x00" + msg.MessageID))
+	return hex.EncodeToString(digest[:16])
+}
